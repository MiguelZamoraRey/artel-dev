---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/layout/PageIntro.astro';
import NightPanel from '../../components/sections/NightPanel.astro';
import Members from '../../components/sections/Members.astro';
import { loadMembers } from '../../lib/collections';
import { useTranslations } from '../../lib/i18n';
import type { Lang } from '../../lib/i18n';

const lang: Lang = 'es';
const dict = useTranslations(lang);
const members = await loadMembers(lang);
---

<BaseLayout title={dict.members.page.metaTitle} description={dict.members.page.metaDescription} lang={lang}>
  <PageIntro title={dict.members.page.title} lead={dict.members.page.lead} />
  <NightPanel lang={lang} />
  <Members lang={lang} members={members} />
</BaseLayout>
