---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { alternatePath, getLangFromUrl, useTranslations } from '../lib/i18n';
import type { Lang } from '../lib/i18n';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  showLanguage?: boolean;
  alternates?: boolean;
  canonical?: boolean;
}

const {
  title,
  description,
  lang = getLangFromUrl(Astro.url),
  showLanguage = true,
  alternates = true,
  canonical: showCanonical = true,
} = Astro.props;

const dict = useTranslations(lang);
const site = Astro.site ?? Astro.url.origin;
const canonicalUrl = new URL(Astro.url.pathname, site);
const canonicalHref = showCanonical ? canonicalUrl.href : new URL('/', site).href;
const esUrl = new URL(alternatePath(Astro.url.pathname, 'es'), site);
const enUrl = new URL(alternatePath(Astro.url.pathname, 'en'), site);
const ogLocale = lang === 'en' ? 'en_GB' : 'es_ES';
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F4ECD8" />
    <link rel="icon" href="/favicon.png" />
    {showCanonical && <link rel="canonical" href={canonicalUrl.href} />}
    {alternates && (
      <>
        <link rel="alternate" hreflang="es" href={esUrl.href} />
        <link rel="alternate" hreflang="en" href={enUrl.href} />
        <link rel="alternate" hreflang="x-default" href={esUrl.href} />
      </>
    )}
    <meta property="og:site_name" content="artel" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      (() => {
        document.documentElement.classList.add('js');
        let saved = null;
        try { saved = localStorage.getItem('artel-theme'); } catch (e) {}
        const theme = saved === 'light' || saved === 'dark'
          ? saved
          : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.dataset.theme = theme;
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.content = theme === 'dark' ? '#14140C' : '#F4ECD8';
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#contenido">{dict.common.skip}</a>
    <div class="grain" aria-hidden="true"></div>
    <Header lang={lang} showLanguage={showLanguage} />
    <main id="contenido">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
