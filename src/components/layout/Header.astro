---
import Logo from '../brand/Logo.astro';
import ThemeToggle from '../ui/ThemeToggle.astro';
import { alternatePath, localizedPath, useTranslations } from '../../lib/i18n';
import type { Lang } from '../../lib/i18n';

interface Props {
  lang: Lang;
  showLanguage?: boolean;
  showProjects?: boolean;
}

const { lang, showLanguage = true, showProjects = true } = Astro.props;
const dict = useTranslations(lang);
const path = Astro.url.pathname;
const home = localizedPath('/', lang);
const nav = [
  { label: dict.nav.manifesto, href: `${home}#manifiesto` },
  ...(showProjects
    ? [{ label: dict.nav.projects, href: localizedPath('/proyectos/', lang) }]
    : []),
  { label: dict.nav.members, href: localizedPath('/socios/', lang) },
  { label: dict.nav.join, href: localizedPath('/unirse/', lang) },
  { label: dict.nav.faq, href: localizedPath('/faq/', lang) },
];
const isCurrent = (href: string): boolean =>
  !href.includes('#') && (path === href || path.startsWith(href));
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href={home} aria-label={dict.common.homeLabel}>
      <Logo size={40} />
      <span class="wordmark">artel</span>
    </a>
    <nav class="nav" aria-label={dict.common.navLabel}>
      <ul>
        {nav.map((item) => (
          <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    {showLanguage && (
      <div class="lang" role="group" aria-label={dict.common.language}>
        {lang === 'es' ? (
          <>
            <span class="on" aria-current="true">ES</span>
            <span class="sep" aria-hidden="true">/</span>
            <a class="off" href={alternatePath(path, 'en')} lang="en" hreflang="en">EN</a>
          </>
        ) : (
          <>
            <a class="off" href={alternatePath(path, 'es')} lang="es" hreflang="es">ES</a>
            <span class="sep" aria-hidden="true">/</span>
            <span class="on" aria-current="true">EN</span>
          </>
        )}
      </div>
    )}
    <ThemeToggle light={dict.common.themeLight} dark={dict.common.themeDark} ariaLabel={dict.common.themeLabel} />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    min-height: 68px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: .7rem;
    text-decoration: none;
    color: var(--ink);
  }

  .wordmark {
    font-family: var(--display);
    font-size: 1.75rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: .01em;
  }

  .nav {
    margin-left: auto;
  }

  .nav ul {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav a {
    display: inline-block;
    padding-block: .35rem;
    font-family: var(--mono);
    font-size: var(--step--1);
    font-weight: 400;
    letter-spacing: .13em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink-soft);
    border-bottom: 1px solid transparent;
  }

  .nav a:hover {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }

  .lang {
    display: flex;
    align-items: center;
    gap: .45rem;
    margin-left: 2rem;
    font-family: var(--mono);
    font-size: var(--step--1);
    letter-spacing: .1em;
    color: var(--ink-soft);
  }

  .lang .on {
    color: var(--ink);
    border-bottom: 1px solid var(--accent);
  }

  .lang .sep {
    opacity: .5;
  }

  .lang .off {
    opacity: .55;
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .lang .off:hover {
    opacity: 1;
    border-bottom-color: var(--accent);
  }

  @media (max-width: 820px) {
    .header-inner {
      flex-wrap: wrap;
      gap: .4rem 1rem;
      padding-block: .55rem;
    }

    .nav {
      order: 3;
      width: 100%;
      margin-left: 0;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .nav::-webkit-scrollbar {
      display: none;
    }

    .nav ul {
      gap: .9rem;
    }

    .lang {
      order: 2;
      margin-left: auto;
    }

    .wordmark {
      font-size: 1.55rem;
    }
  }

  @media print {
    .site-header {
      display: none;
    }
  }
</style>
