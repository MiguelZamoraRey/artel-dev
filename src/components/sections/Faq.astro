---
import Kicker from '../ui/Kicker.astro';
import { useTranslations } from '../../lib/i18n';
import type { Lang } from '../../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = useTranslations(lang);
const { faq } = dict;
---

<section class="section" id="faq">
  <div class="wrap">
    <Kicker number={faq.number} label={faq.kicker} />
    <h2>{faq.title}</h2>

    <div class="faq-list">
      {faq.items.map((item, index) => (
        <details>
          <summary>
            <span class="q-n mono">{String(index + 1).padStart(2, '0')}</span>
            <span class="q">{item.question}</span>
            <span class="pm" aria-hidden="true"></span>
          </summary>
          <div class="answer">
            <p>{item.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-list {
    margin-top: clamp(2rem, 5vh, 3rem);
    border-top: 1px solid var(--rule);
  }

  details {
    border-bottom: 1px solid var(--rule);
  }

  summary {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) 1.5rem;
    gap: 1rem;
    align-items: baseline;
    padding-block: 1.3rem;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .q-n {
    line-height: 1.65;
    color: var(--accent-deep);
  }

  .q {
    font-family: var(--display);
    font-size: clamp(1.25rem, 1.08rem + .55vw, 1.55rem);
    font-weight: 400;
    line-height: 1.25;
  }

  summary:hover .q {
    color: var(--ink);
  }

  .pm {
    position: relative;
    width: 15px;
    height: 15px;
    justify-self: end;
    align-self: center;
  }

  .pm::before,
  .pm::after {
    content: "";
    position: absolute;
    left: 0;
    top: 7px;
    width: 15px;
    height: 1px;
    background: var(--ink);
    transition: transform .18s ease;
  }

  .pm::after {
    transform: rotate(90deg);
  }

  details[open] .pm::after {
    transform: rotate(0deg);
  }

  .answer {
    padding: 0 0 1.6rem 3.5rem;
    max-width: 64ch;
    color: var(--ink-soft);
    font-size: calc(var(--step-0) * .95);
    line-height: 1.65;
  }

  @media (max-width: 640px) {
    .answer {
      padding-left: 3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pm::before,
    .pm::after {
      transition: none;
    }
  }
</style>
