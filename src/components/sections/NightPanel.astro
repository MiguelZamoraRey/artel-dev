---
import Kicker from '../ui/Kicker.astro';
import { useTranslations } from '../../lib/i18n';
import type { Lang } from '../../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = useTranslations(lang);
const { panel } = dict;
---

<section class="night" id="socios">
  <svg class="radial" viewBox="0 0 640 640" aria-hidden="true" focusable="false">
    <defs>
      <line id="spoke" x1="320" y1="230" x2="320" y2="46" />
      <path id="petal" d="M320 320 C342 278 342 228 320 188 C298 228 298 278 320 320" />
      <circle id="bead" cx="320" cy="118" r="2.2" />
    </defs>
    <g fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="320" cy="320" r="300" stroke-dasharray="1 14" opacity=".55" />
      <circle cx="320" cy="320" r="280" />
      <circle cx="320" cy="320" r="150" stroke-dasharray="2 9" opacity=".8" />
      <circle cx="320" cy="320" r="64" />
      <circle cx="320" cy="320" r="40" />
      <circle cx="320" cy="320" r="12" />
      <g>
        <use href="#spoke" />
        <use href="#spoke" transform="rotate(15 320 320)" />
        <use href="#spoke" transform="rotate(30 320 320)" />
        <use href="#spoke" transform="rotate(45 320 320)" />
        <use href="#spoke" transform="rotate(60 320 320)" />
        <use href="#spoke" transform="rotate(75 320 320)" />
        <use href="#spoke" transform="rotate(90 320 320)" />
        <use href="#spoke" transform="rotate(105 320 320)" />
        <use href="#spoke" transform="rotate(120 320 320)" />
        <use href="#spoke" transform="rotate(135 320 320)" />
        <use href="#spoke" transform="rotate(150 320 320)" />
        <use href="#spoke" transform="rotate(165 320 320)" />
        <use href="#spoke" transform="rotate(180 320 320)" />
        <use href="#spoke" transform="rotate(195 320 320)" />
        <use href="#spoke" transform="rotate(210 320 320)" />
        <use href="#spoke" transform="rotate(225 320 320)" />
        <use href="#spoke" transform="rotate(240 320 320)" />
        <use href="#spoke" transform="rotate(255 320 320)" />
        <use href="#spoke" transform="rotate(270 320 320)" />
        <use href="#spoke" transform="rotate(285 320 320)" />
        <use href="#spoke" transform="rotate(300 320 320)" />
        <use href="#spoke" transform="rotate(315 320 320)" />
        <use href="#spoke" transform="rotate(330 320 320)" />
        <use href="#spoke" transform="rotate(345 320 320)" />
      </g>
      <g>
        <use href="#petal" />
        <use href="#petal" transform="rotate(60 320 320)" />
        <use href="#petal" transform="rotate(120 320 320)" />
        <use href="#petal" transform="rotate(180 320 320)" />
        <use href="#petal" transform="rotate(240 320 320)" />
        <use href="#petal" transform="rotate(300 320 320)" />
      </g>
      <g>
        <use href="#bead" />
        <use href="#bead" transform="rotate(30 320 320)" />
        <use href="#bead" transform="rotate(60 320 320)" />
        <use href="#bead" transform="rotate(90 320 320)" />
        <use href="#bead" transform="rotate(120 320 320)" />
        <use href="#bead" transform="rotate(150 320 320)" />
        <use href="#bead" transform="rotate(180 320 320)" />
        <use href="#bead" transform="rotate(210 320 320)" />
        <use href="#bead" transform="rotate(240 320 320)" />
        <use href="#bead" transform="rotate(270 320 320)" />
        <use href="#bead" transform="rotate(300 320 320)" />
        <use href="#bead" transform="rotate(330 320 320)" />
      </g>
    </g>
  </svg>

  <div class="wrap night-inner">
    <Kicker number={panel.number} label={panel.kicker} />
    <h2>{panel.title}</h2>
    {panel.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    <p class="night-caption mono">{panel.caption}</p>
  </div>
</section>

<style>
  .night {
    --kicker-color: var(--panel-soft);
    --kicker-num: var(--panel-accent);
    --kicker-rule: var(--panel-rule);
    position: relative;
    overflow: hidden;
    padding-block: clamp(4.5rem, 11vh, 8rem);
    background-color: var(--panel);
    background-image: radial-gradient(circle at 50% 35%, rgba(232, 224, 204, .05), transparent 70%);
    color: var(--panel-ink);
    border-block: 1px solid var(--panel-rule);
  }

  .night h2 {
    margin: 0 0 clamp(1.25rem, 3vh, 2rem);
    font-size: clamp(2.3rem, 1.5rem + 3.2vw, 4.2rem);
    line-height: 1;
    max-width: 16ch;
    color: var(--panel-ink);
  }

  .night p {
    max-width: 46ch;
    margin-bottom: 1.1rem;
    color: var(--panel-soft);
  }

  .night p:last-of-type {
    margin-bottom: 0;
  }

  .night-inner {
    position: relative;
    z-index: 1;
  }

  .night-caption {
    margin-top: clamp(2.5rem, 6vh, 4rem);
    line-height: 1.65;
    font-size: .68rem;
    letter-spacing: .16em;
    color: var(--panel-soft);
  }

  .radial {
    position: absolute;
    top: 50%;
    right: -6%;
    z-index: 0;
    width: min(72vw, 720px);
    aspect-ratio: 1;
    transform: translateY(-50%);
    color: var(--panel-ink);
    opacity: .16;
    pointer-events: none;
  }

  .night :focus-visible {
    outline-color: var(--panel-accent);
  }
</style>
