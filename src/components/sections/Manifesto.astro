---
import Kicker from '../ui/Kicker.astro';
import ScrollPlate from '../decor/ScrollPlate.astro';
import { useTranslations } from '../../lib/i18n';
import type { Lang } from '../../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = useTranslations(lang);
const { manifesto } = dict;
---

<section class="section manifesto-sec" id="manifiesto">
  <div class="wrap">
    <Kicker number={manifesto.number} label={manifesto.kicker} />
    <h2>{manifesto.title}</h2>

    <div class="manifesto">
      {manifesto.paragraphs.map((paragraph, index) => (
        <div class="m-row">
          <p class="m-note">{manifesto.notes[index]}</p>
          <div class="m-body">
            <p class={index === 0 ? 'body' : undefined}>{paragraph}</p>
            {index === manifesto.paragraphs.length - 1 && <p class="manifesto-sign">{manifesto.sign}</p>}
          </div>
        </div>
      ))}
    </div>

    <ScrollPlate caption={manifesto.plateCaption} />
  </div>
</section>

<style>
  .manifesto-sec {
    position: relative;
    overflow: hidden;
  }

  .manifesto-sec .wrap {
    position: relative;
  }

  .manifesto {
    margin-top: clamp(2rem, 5vh, 3rem);
  }

  .m-row {
    display: grid;
    grid-template-columns: 150px minmax(0, var(--measure));
    column-gap: clamp(2rem, 4vw, 3rem);
    margin-bottom: 1.5rem;
  }

  .m-note {
    padding-top: .5rem;
    max-width: 19ch;
    font-family: var(--display);
    font-size: 1rem;
    font-style: italic;
    font-weight: 300;
    line-height: 1.35;
    color: var(--ink-soft);
  }

  .m-note::before {
    content: "";
    display: block;
    width: 26px;
    height: 1px;
    margin-bottom: .55rem;
    background: var(--rule);
  }

  .m-body {
    position: relative;
    z-index: 1;
    max-width: var(--measure);
    background: var(--paper);
  }

  .m-body p {
    margin-bottom: 1.25rem;
  }

  .m-body p:last-child {
    margin-bottom: 0;
  }

  .m-body p.body:first-of-type::first-letter {
    float: left;
    margin: .06em .1em 0 0;
    padding-top: .04em;
    font-family: var(--display);
    font-size: 3.7em;
    font-weight: 400;
    line-height: .78;
    color: var(--ink);
  }

  .manifesto-sign {
    margin-top: 1.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
    text-align: right;
    font-family: var(--display);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--ink-soft);
  }

  @media (max-width: 1199px) {
    .m-row {
      grid-template-columns: 130px minmax(0, var(--measure));
      column-gap: clamp(1.5rem, 3vw, 2.5rem);
    }
  }

  @media (max-width: 899px) {
    .m-row {
      grid-template-columns: minmax(0, 1fr);
      row-gap: .5rem;
      margin-bottom: 2rem;
    }

    .m-note {
      max-width: 34ch;
      padding-top: 0;
    }
  }
</style>
