  </svg>
  <p class="plate-caption">{caption}</p>
</div>

<div class="plate-sep" aria-hidden="true">
  <span></span><span class="mid"></span><span></span>
</div>

<script>
  import '../../scripts/scroll-draw';
</script>

<style>
  .plate {
    position: relative;
    z-index: 0;
    width: min(38vw, 520px);
    margin: clamp(2.5rem, 6vh, 4rem) 0 0 auto;
    color: var(--ink);
    pointer-events: none;
    user-select: none;
  }

  .plate svg {
    display: block;
    width: 100%;
    height: auto;
    opacity: .14;
  }

  html[data-theme="dark"] .plate svg {
    opacity: .18;
  }

  .plate-caption {
    margin-top: .6rem;
    text-align: right;
    font-family: var(--display);
    font-style: italic;
    font-size: .98rem;
    color: var(--ink-soft);
  }

  .plate svg path {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  .plate.is-armed svg path {
    stroke-dashoffset: calc(1 - var(--draw, 0));
  }

  .plate-sep {
    display: none;
    align-items: center;
    justify-content: center;
    gap: .7rem;
    margin-block: 2.25rem .5rem;
  }

  .plate-sep span {
    display: block;
    width: 56px;
    height: 1px;
    background: var(--rule);
  }

  .plate-sep span.mid {
    width: 5px;
    height: 5px;
    border: 1px solid var(--ink-soft);
    background: none;
    transform: rotate(45deg);
  }

  @media (min-width: 1200px) {
    .plate {
      position: absolute;
      top: clamp(0rem, 1vh, 1.25rem);
      right: 0;
      margin: 0;
    }
  }

  @media (max-width: 899px) {
    .plate {
      display: none;
    }

    .plate-sep {
      display: flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .plate svg path {
      stroke-dashoffset: 0 !important;
    }
  }

  @media print {
    .plate svg path {
      stroke-dashoffset: 0 !important;
    }
  }
</style>
