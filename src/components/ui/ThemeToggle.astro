---
interface Props {
  light: string;
  dark: string;
  ariaLabel: string;
}

const { light, dark, ariaLabel } = Astro.props;
---

<button class="theme-toggle" type="button" aria-pressed="false" aria-label={ariaLabel}>
  <svg class="theme-icon sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2.5v2.4M12 19.1v2.4M2.5 12h2.4M19.1 12h2.4M5.3 5.3l1.7 1.7M17 17l1.7 1.7M18.7 5.3 17 7M7 17l-1.7 1.7" />
  </svg>
  <svg class="theme-icon moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
  </svg>
  <span class="theme-label" aria-hidden="true"><span class="t-light">{light}</span><span class="t-dark">{dark}</span></span>
</button>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const toggle = document.querySelector('.theme-toggle');
    const meta = document.querySelector('meta[name="theme-color"]');
    if (!toggle) return;

    const sync = (theme) => {
      toggle.setAttribute('aria-pressed', String(theme === 'dark'));
      if (meta) meta.content = theme === 'dark' ? '#14140C' : '#F4ECD8';
    };

    sync(root.dataset.theme === 'dark' ? 'dark' : 'light');

    toggle.addEventListener('click', () => {
      const theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = theme;
      sync(theme);
      try { localStorage.setItem('artel-theme', theme); } catch (e) {}
    });
  })();
</script>

<style>
  .theme-toggle {
    display: none;
    align-items: center;
    gap: .45rem;
    margin-left: 1.25rem;
    padding: .4rem .55rem;
    border: 1px solid var(--rule);
    background: none;
    color: var(--ink-soft);
    font-family: var(--mono);
    font-size: var(--step--1);
    letter-spacing: .12em;
    line-height: 1;
    text-transform: uppercase;
    cursor: pointer;
    transition: color .18s ease, border-color .18s ease;
  }

  :global(.js) .theme-toggle {
    display: inline-flex;
  }

  .theme-toggle:hover,
  .theme-toggle[aria-pressed="true"],
  html[data-theme="dark"] .theme-toggle {
    color: var(--ink);
    border-color: var(--accent);
  }

  .theme-icon {
    display: block;
    flex: none;
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .theme-toggle .moon,
  .theme-toggle .t-dark {
    display: none;
  }

  html[data-theme="dark"] .theme-toggle .sun,
  html[data-theme="dark"] .theme-toggle .t-light {
    display: none;
  }

  html[data-theme="dark"] .theme-toggle .moon {
    display: block;
  }

  html[data-theme="dark"] .theme-toggle .t-dark {
    display: inline;
  }

  @media (max-width: 820px) {
    .theme-toggle {
      order: 2;
      margin-left: .9rem;
      padding: .35rem .5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle {
      transition: none;
    }
  }
</style>
