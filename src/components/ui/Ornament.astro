      <path d="M196 20 C204 19 212 18 219 18" />
      <circle cx="180" cy="20" r="1.6" />
    </g>
    <g transform="translate(240 0) scale(-1 1)">
      <path d="M120 20 H196" />
      <path d="M120 20 C134 20 142 12 152 12 C161 12 164 21 156 23 C150 24 148 18 153 16" />
      <path d="M120 20 C134 20 142 28 152 28 C161 28 164 19 156 17 C150 16 148 22 153 24" />
      <path d="M196 20 C204 14 214 14 220 18 C213 24 203 25 196 20" />
      <path d="M196 20 C204 19 212 18 219 18" />
