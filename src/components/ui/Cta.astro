---
interface Props {
  label: string;
  email: string;
  note: string;
}

const { label, email, note } = Astro.props;
---

<p class="cta-label mono">{label}</p>
<a class="email" href={`mailto:${email}`}>{email}</a>
<p class="cta-note">{note}</p>

<style>
  .cta-label {
    margin-bottom: .9rem;
    color: var(--ink-soft);
  }

  .email {
    display: inline-block;
    font-family: var(--display);
    font-size: clamp(1.7rem, 1.25rem + 1.5vw, 2.5rem);
    font-weight: 400;
    line-height: 1.1;
    text-decoration: none;
    border-bottom: 1px solid var(--accent);
    padding-bottom: .1em;
  }

  .email:hover {
    border-bottom-color: var(--ink);
  }

  .cta-note {
    max-width: 34ch;
    margin-top: 1.25rem;
    font-family: var(--display);
    font-style: italic;
    font-size: 1.08rem;
    line-height: 1.45;
    color: var(--ink-soft);
  }
</style>
